// src/components/Footer.tsx
import * as React from "react";
import { Link } from "@tanstack/react-router";

const EMAIL = "info@coreholdingcorp.com";

export default function Footer() {
  const [copied, setCopied] = React.useState(false);

  async function copyEmail() {
    try {
      await navigator.clipboard.writeText(EMAIL);
      setCopied(true);
      window.setTimeout(() => setCopied(false), 1200);
    } catch {
      // Fallback: still no mailto. Just select text via prompt.
      window.prompt("Copy email address:", EMAIL);
    }
  }

  return (
    <footer className="mt-16 border-t border-white/10 bg-black/20">
      <div className="mx-auto max-w-6xl px-4 py-10">
        <div className="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
          <div className="space-y-2">
            <div className="text-sm font-semibold tracking-wide text-white/90">
              CORE HOLDING CORPORATION
            </div>
            <div className="text-sm text-white/60">
              Governance-First AI Infrastructure
            </div>
          </div>

          <div className="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div className="space-y-2">
              <div className="text-xs font-semibold uppercase tracking-wide text-white/60">
                Navigate
              </div>
              <ul className="space-y-2 text-sm">
                <li>
                  <Link
                    to="/portfolio"
                    className="text-white/80 hover:text-white hover:underline"
                  >
                    Portfolio
                  </Link>
                </li>
                <li>
                  <Link
                    to="/contact"
                    className="text-white/80 hover:text-white hover:underline"
                  >
                    Contact
                  </Link>
                </li>
              </ul>
            </div>

            <div className="space-y-2">
              <div className="text-xs font-semibold uppercase tracking-wide text-white/60">
                Email
              </div>

              <div className="flex items-center gap-3">
                <span className="select-text text-sm text-white/80">
                  {EMAIL}
                </span>
                <button
                  type="button"
                  onClick={copyEmail}
                  className="rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-semibold text-white/80 hover:bg-white/10"
                  aria-label="Copy email address"
                >
                  {copied ? "Copied" : "Copy"}
                </button>
              </div>

              <div className="text-xs text-white/50">
                Use the form on the Contact page to send a message.
              </div>
            </div>
          </div>
        </div>

        <div className="mt-10 text-xs text-white/40">
          © {new Date().getFullYear()} Core Holding Corporation. All rights reserved.
        </div>
      </div>
    </footer>
  );
}
